# Sagla optional che. Koi API key jaruri nathi.

# Indian gold/silver "indicative" price = international price x USD/INR x (1 + premium%).
# Premium = import duty + cess (GST ane making charges shamil nathi). Sarkar duty badle tyare badlo.
INDIA_BULLION_PREMIUM_PCT=6
# GST jo "incl. GST" line ma umeravi (default 3)
INDIA_GST_PCT=3

# Upstream timeouts (ms)
UPSTREAM_TIMEOUT_MS=8000

PORT=3000

# "Talk to us" button (header + page bottom). Beyma thi ek set karo, nahi to button batavvama nahi aave.
# NEXT_PUBLIC_ vars build time par inline thay che — badal karya pachhi navo build karo.
# Country code sathe digits, + vagar (jem 919XXXXXXXXX):
NEXT_PUBLIC_WHATSAPP=
# Athva koi contact / enquiry page nu full https URL:
NEXT_PUBLIC_CONTACT_URL=

# Mutual funds ma kayo plan batavvo: regular (default) | direct | any
MF_PLAN=regular

# Intraday ticks ni file (writable folder). Default: ./.data
# DATA_DIR=

# ===== Mutual Fund Intelligence (MySQL + cron) =====
# Hostinger hPanel -> Databases -> MySQL: database/user banavi ahi nakho
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Cron URL protect karva: 32+ random characters (openssl rand -hex 24)
CRON_SECRET=
# Admin login: node scripts/hash-password.mjs 'your-long-password'  -> output ADMIN_PASSWORD_HASH ma
ADMIN_USER=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Failure email (Hostinger Email SMTP: smtp.hostinger.com, port 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ALERT_EMAIL=alpesh@kanethic.com
# Optional: history years (default 5), minimum rows to accept an AMFI file (default 1000)
# BACKFILL_YEARS=5
# MIN_NAV_ROWS=1000
